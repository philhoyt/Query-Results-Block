{
	"name": "query-results-block",
	"version": "1.1.0",
	"description": "WordPress plugin that adds a dynamic inner block for core/query",
	"main": "build/index.js",
	"scripts": {
		"build": "wp-scripts build",
		"plugin-zip": "rm -rf dist query-results-block.zip && mkdir -p dist/query-results-block && cp -r query-results-block.php build lib README.md dist/query-results-block/ && cd dist && zip -qr ../query-results-block.zip query-results-block && cd .. && rm -rf dist",
		"start": "wp-scripts start",
		"dev": "wp-scripts start",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"test:unit": "wp-scripts test-unit-js --passWithNoTests",
		"test:e2e": "wp-scripts test-playwright",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"env:clean": "wp-env clean",
		"test:php": "wp-env run tests-cli --env-cwd wp-content/plugins/query-results-block -- vendor/bin/phpunit",
		"packages-update": "wp-scripts packages-update"
	},
	"keywords": [
		"wordpress",
		"gutenberg",
		"block",
		"query"
	],
	"author": "Phil Hoyt",
	"license": "GPL-2.0-or-later",
	"devDependencies": {
		"@wordpress/block-editor": "^20.0.0",
		"@wordpress/blocks": "^17.1.0",
		"@wordpress/env": "^12.1.0",
		"@wordpress/eslint-plugin": "^28.1.0",
		"@wordpress/i18n": "^7.1.0",
		"@wordpress/scripts": "^37.1.0",
		"@wordpress/stylelint-config": "^27.1.0",
		"prettier": "npm:wp-prettier@^3.9.6",
		"vite": "^8.3.5",
		"vitest": "^5.1.0"
	}
}
